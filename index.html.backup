          </div>
          <div class="logo-strip__item">
            <div class="logo-placeholder"><i class="fa-solid fa-gears"></i><span>Engineering Co.</span></div>
          </div>
          <div class="logo-strip__item">
            <div class="logo-placeholder"><i class="fa-solid fa-truck"></i><span>Logistics Partner</span></div>
          </div>
          <div class="logo-strip__item">
            <div class="logo-placeholder"><i class="fa-solid fa-microchip"></i><span>Tech OEM</span></div>
          </div>
          <div class="logo-strip__item">
            <div class="logo-placeholder"><i class="fa-solid fa-bolt"></i><span>EV Manufacturer</span></div>
          </div>
        </div>
        <p class="logo-strip__note fade-in">Client logos shown under NDA agreements. Contact us for references.</p>

        <!-- Operational Locations -->
        <div class="locations-strip fade-in">
          <h3 class="locations-strip__title">Operational Presence</h3>
          <div class="locations-strip__grid">
            <div class="location-pill">
              <i class="fa-solid fa-building"></i>
              <div>
                <strong>India</strong>
                <span>HQ & Engineering Hub — Pune</span>
              </div>
            </div>
            <div class="location-pill">
              <i class="fa-solid fa-warehouse"></i>
              <div>
                <strong>North America</strong>
                <span>Warehouse & Operations — Wixom, MI</span>
              </div>
            </div>
            <div class="location-pill">
              <i class="fa-solid fa-cogs"></i>
              <div>
                <strong>Europe</strong>
                <span>Technical Support — Germany / UK</span>
              </div>
            </div>
            <div class="location-pill">
              <i class="fa-solid fa-handshake"></i>
              <div>
                <strong>Mexico</strong>
                <span>Project-based Collaborations</span>
              </div>
            </div>
          </div>
        </div>
      </div>
