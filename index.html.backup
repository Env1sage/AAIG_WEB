          <form class="contact-form fade-in" id="contactForm" enctype="multipart/form
                </p>
              </div>
            </div>
            
            <div class="contact__links">
              <a href="https://www.aaig-group.com" target="_blank" rel="noopener noreferrer" class="contact__link"><i class="fa-solid fa-globe"></i> www.aaig-group.com</a>
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="contact__link"><i class="fa-brands fa-linkedin"></i> LinkedIn</a>
              <a href="mailto:info@aaig-group.com" class="contact__link"><i class="fa-solid fa-envelope"></i> Email</a>
            </div>
          </div>
          
          <form class="contact-form fade-in" id="contactForm" enctype="multipart/form-data">
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="name">Full Name *</label>
                <input type="text" id="name" name="name" class="form-input" required aria-required="true">
              </div>
              <div class="form-group">
                <label class="form-label" for="company">Company *</label>
                <input type="text" id="company" name="company" class="form-input" required aria-required="true">
              </div>
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="email">Email Address *</label>
                <input type="email" id="email" name="email" class="form-input" required aria-required="true">
              </div>
              <div class="form-group">
                <label class="form-label" for="phone">Phone Number *</label>
                <input type="tel" id="phone" name="phone" class="form-input" required aria-required="true">
              </div>
            </div>
            
            <div class="form-row">
              <div class="form-group">
                <label class="form-label" for="country">Country</label>
                <input type="text" id="country" name="country" class="form-input" placeholder="e.g., United States">
              </div>
              <div class="form-group">
                <label class="form-label" for="city">City</label>
                <input type="text" id="city" name="city" class="form-input" placeholder="e.g., Detroit">
              </div>
            </div>
            
            <div class="form-group">
              <label class="form-label">Service Interest (select all that apply) *</label>
              <div class="checkbox-group" role="group" aria-label="Service interest options">
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="inspection"> 
                  <span>Inspection & Sorting</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="rework"> 
                  <span>Technical Rework</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="containment"> 
                  <span>Containment</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="representation"> 
                  <span>Global Representation</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="warehousing"> 
                  <span>Warehousing & Logistics</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="launch"> 
                  <span>Launch Support</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="resident-engineer"> 
                  <span>Resident Engineer</span>
                </label>
                <label class="checkbox-item">
                  <input type="checkbox" name="service" value="other"> 
                  <span>Other</span>
                </label>
              </div>
            </div>
            
            <div class="form-group">
              <label class="form-label" for="urgency">Urgency</label>
              <select id="urgency" name="urgency" class="form-select">
                <option value="">Select urgency level...</option>
                <option value="emergency">🔴 Emergency (deploy within 48 hours)</option>
                <option value="7days">🟡 Within 7 days</option>
                <option value="standard">🟢 Standard (planning phase)</option>
              </select>
            </div>
            
            <div class="form-group">
              <label class="form-label" for="fileUpload">Upload Images / Files (optional)</label>
              <div class="file-upload-area" id="fileUploadArea">
                <input type="file" id="fileUpload" name="files" class="file-input" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx" aria-describedby="fileUploadHelp">
                <div class="file-upload-label">
                  <i class="fa-solid fa-cloud-arrow-up"></i>
                  <span>Drag & drop files here or <strong>browse</strong></span>
                  <small id="fileUploadHelp">Accept: Images, PDF, DOC, XLS (max 10MB each)</small>
                </div>
              </div>
            </div>
            
            <div class="form-group">
              <label class="form-label" for="message">Message</label>
              <textarea id="message" name="message" class="form-textarea" rows="4" placeholder="Tell us about your requirements, part numbers, volumes, or describe the quality issue..."></textarea>
            </div>
            
            <div class="form-group form-consent">
              <label class="checkbox-item consent-checkbox">
                <input type="checkbox" name="consent" id="consent" required aria-required="true">
                <span>I consent to AAIG contacting me regarding this inquiry and agree to the <a href="privacy-policy.html" target="_blank" rel="noopener">Privacy Policy</a>. *</span>
              </label>
            </div>
            
            <button type="submit" class="btn btn--primary btn--full">
              <i class="fa-solid fa-paper-plane"></i>
              Send Inquiry
            </button>
          </form>
        </div>
      </div>
    </section>
