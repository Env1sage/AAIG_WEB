    <!-- ==================== CASE STUDIES & CERTIFICATIONS ==================== -->
    <section id="cases" class="section section--warm">
      <div class="container">
        <div class="two-col-section">
          <!-- Case Studies Column -->
          <div class="cases-col fade-in">
            <span class="section-tag"><i class="fa-solid fa-chart-line"></i> Proven Results</span>
            <h2 class="section-title" style="text-align:left;">Global Execution — Delivered with Discretion</h2>
            <p style="margin-bottom: var(--space-xl); color: var(--slate);">All programs executed under confidential agreements and ethical business standards.</p>

            <div class="case-study-cards">
              <article class="case-mini-card">
                <div class="case-mini-card__tag">North America</div>
                <h4>Rapid Containment — Major OEM</h4>
                <p>Deployed containment team + resident engineer within 48 hours; 3-step rework at Wixom facility.</p>
                <div class="case-mini-card__results">
                  <span><i class="fa-solid fa-arrow-down"></i> 85% downtime reduction</span>
                  <span><i class="fa-solid fa-dollar-sign"></i> 32% cost savings</span>
                </div>
              </article>
              <article class="case-mini-card">
                <div class="case-mini-card__tag">Europe</div>
                <h4>Deviation Management — OEM Partner</h4>
                <p>Established real-time feedback loop, on-site quality liaison, and root cause analysis program.</p>
                <div class="case-mini-card__results">
                  <span><i class="fa-solid fa-arrow-down"></i> 94% defect reduction</span>
                  <span><i class="fa-solid fa-handshake"></i> Contract renewed</span>
                </div>
              </article>
              <article class="case-mini-card">
                <div class="case-mini-card__tag">Mexico</div>
                <h4>Partner Warehouse Rework</h4>
                <p>Coordinated on-site rework program with dedicated technicians and sequencing operations.</p>
                <div class="case-mini-card__results">
                  <span><i class="fa-solid fa-clock"></i> 60% faster turnaround</span>
                  <span><i class="fa-solid fa-check-circle"></i> Zero delays</span>
                </div>
              </article>
            </div>

