              <path d="M5 20C5 20 10 12 20 12C30 12 35 20 35 20" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              <path d="M5 28C5 28 10 20 20 20C30 20 35 28 35 28" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
            </svg>
