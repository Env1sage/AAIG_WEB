            <div class="contact-cards">
              <div class="contact-card">
                <h4 class="contact-card__title"><i class="fa-solid fa-building"></i> India Office (HQ)</h4>
                <p class="contact-card__detail">
                  <i class="fa-solid fa-location-dot"></i>
                  AA Infinite Global Services, Pune, Maharashtra – 411046
                </p>
                <p class="contact-card__detail">
