  <!-- Sticky Mobile CTA -->
  <div class="mobile-sticky-cta" id="mobileCta">
    <div class="mobile-sticky-cta__inner">
      <a href="tel:+919960717177" class="btn btn--call"><i class="fa-solid fa-phone"></i> Call Now</a>
      <a href="#contact" class="btn btn--primary"><i class="fa-solid fa-bolt"></i> Emergency Response</a>
