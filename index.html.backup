    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Wixom",
      "addressRegion": "MI",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 42.5248,
      "longitude": -83.5374
    },
    "openingHoursSpecification": {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
      "opens": "08:00",
      "closes": "18:00"
    }
  }
  </script>

  <!-- FAQ Schema for SEO -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {
        "@type": "Question",
        "name": "What services does AAIG provide?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AAIG provides quality engineering, technical rework, containment, inspection, global representation, warehousing & logistics, and resident engineering services across India, North America, and Europe."
        }
      },
      {
        "@type": "Question",
        "name": "How quickly can AAIG respond to quality emergencies?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AAIG deploys containment teams within 48 hours for emergency quality situations, with 24/7 support across all operational time zones."
        }
      },
      {
        "@type": "Question",
        "name": "Where is AAIG's warehouse located?",
        "acceptedAnswer": {
          "@type": "Answer",
          "text": "AAIG operates a 200,000 sq. ft. bonded warehouse in Wixom, Michigan, USA, supporting inspection, rework, sequencing, and cross-docking operations."
        }
      }
    ]
  }
  </script>
  
