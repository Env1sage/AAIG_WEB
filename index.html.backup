  <main>

    <!-- ==================== HERO SECTION ==================== -->
    <section id="home" class="hero">
      <div class="hero__bg">
        <div class="hero__gradient"></div>
        <div class="hero__particles" aria-hidden="true">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
      </div>
      <div class="container">
        <div class="hero__inner">
          <div class="hero__content">
            <div class="hero__badge">
              <i class="fa-solid fa-shield-halved"></i>
              <span>Trusted by Global OEMs & Tier-1 Suppliers</span>
            </div>
            <h1 class="hero__title">
              Your <span class="text-gradient">Quality Shield</span> — From Line Stop to Line Start
            </h1>
            <p class="hero__description">
              AAIG delivers rapid containment, precision rework, and global representation. We deploy within 48 hours to prevent production halts, reduce costs, and protect your supply chain — across India, North America, and Europe.
            </p>
            <div class="hero__actions">
              <a href="#contact" class="btn btn--primary btn--lg btn--glow">
                <i class="fa-solid fa-bolt"></i> Request Emergency Response
              </a>
              <a href="#contact" class="btn btn--outline-hero btn--lg">
                <i class="fa-regular fa-calendar"></i> Book a Discovery Call
              </a>
            </div>
            <div class="hero__stats-row">
              <div class="hero-stat">
                <div class="hero-stat__number" data-count="48">48<span class="hero-stat__unit">h</span></div>
                <div class="hero-stat__label">Emergency Deploy</div>
              </div>
              <div class="hero-stat__divider"></div>
              <div class="hero-stat">
                <div class="hero-stat__number">200K<span class="hero-stat__unit">sq ft</span></div>
                <div class="hero-stat__label">Wixom Warehouse</div>
              </div>
              <div class="hero-stat__divider"></div>
              <div class="hero-stat">
                <div class="hero-stat__number">3</div>
                <div class="hero-stat__label">Continents Served</div>
              </div>
              <div class="hero-stat__divider"></div>
              <div class="hero-stat">
                <div class="hero-stat__number">25<span class="hero-stat__unit">+yr</span></div>
                <div class="hero-stat__label">Industry Experience</div>
              </div>
            </div>
          </div>
          <div class="hero__visual">
            <div class="hero__image-wrapper">
              <img src="https://images.unsplash.com/photo-1586528116311-ad8dd3c8310d?ixlib=rb-4.0.3&auto=format&fit=crop&w=1600&q=80" alt="AAIG global supply chain and quality engineering operations" loading="eager" width="640" height="480">
              <div class="hero__image-overlay"></div>
            </div>
            <div class="hero__trust-badges">
              <div class="trust-badge"><i class="fa-solid fa-certificate"></i> ISO 9001:2015</div>
              <div class="trust-badge"><i class="fa-solid fa-award"></i> MMSDC Certified</div>
              <div class="trust-badge"><i class="fa-solid fa-clock"></i> 24/7 Support</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ==================== WAREHOUSING & LOGISTICS ==================== -->
    <section id="warehousing" class="section section--warm">
      <div class="container">
        <div class="section-intro fade-in">
          <span class="section-tag"><i class="fa-solid fa-warehouse"></i> Warehousing & Logistics</span>
          <h2 class="section-title">200,000 sq. ft. Wixom, MI — Your North American Hub</h2>
          <p class="section-subtitle">Bonded, climate-controlled, and strategically located to support containment, rework, sequencing, and cross-docking operations for Tier-1 suppliers and OEMs.</p>
        </div>

        <div class="feature-cards-grid stagger-children">
          <article class="feature-card fade-in">
            <div class="feature-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="6" width="22" height="12" rx="2"/><path d="M1 10h22"/></svg>
            </div>
            <h3 class="feature-card__title">Bonded Warehouse</h3>
            <p class="feature-card__desc">U.S. Customs-bonded facility for duty-deferred storage and handling of international shipments.</p>
          </article>
          <article class="feature-card fade-in">
            <div class="feature-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
            <h3 class="feature-card__title">Quality Firewall</h3>
            <p class="feature-card__desc">On-site inspection zones for containment, 100% sorting, and pre-delivery quality verification.</p>
          </article>
          <article class="feature-card fade-in">
            <div class="feature-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
            </div>
            <h3 class="feature-card__title">JIT Sequencing</h3>
            <p class="feature-card__desc">Just-in-time sequencing and cross-docking to keep production lines running without interruption.</p>
          </article>
          <article class="feature-card fade-in">
            <div class="feature-card__icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
            </div>
            <h3 class="feature-card__title">Value-Added Services</h3>
            <p class="feature-card__desc">Repacking, kitting, labeling, and rework services integrated directly into your supply chain flow.</p>
          </article>
        </div>

        <div class="warehouse-metrics fade-in">
          <div class="metric-pill"><strong>200,000</strong> sq. ft.</div>
          <div class="metric-pill"><strong>Bonded</strong> Facility</div>
          <div class="metric-pill"><strong>24/7</strong> Operations</div>
          <div class="metric-pill"><strong>50+</strong> Dock Doors</div>
        </div>

        <div class="section-cta fade-in">
          <a href="warehousing.html" class="btn btn--primary">Explore Warehousing Details</a>
        </div>
      </div>
    </section>

    <!-- ==================== GLOBAL REPRESENTATION & TECHNICAL REWORK ==================== -->
    <section id="global-rep" class="section">
      <div class="container">
        <div class="section-intro fade-in">
          <span class="section-tag"><i class="fa-solid fa-earth-americas"></i> Global Representation & Technical Rework</span>
          <h2 class="section-title">Your On-Ground Partner — Anywhere in the World</h2>
          <p class="section-subtitle">We act as your extended quality team at customer and supplier locations, managing deviation resolution, technical rework, and OEM communication so you don't need a local office.</p>
        </div>

        <div class="split-section stagger-children">
          <div class="split-section__cards">
            <article class="icon-card fade-in">
              <div class="icon-card__icon"><i class="fa-solid fa-user-tie"></i></div>
              <div class="icon-card__content">
                <h3>Resident Engineer / Quality Liaison</h3>
                <p>Dedicated professionals embedded at your customer's plant, providing daily coordination and issue management.</p>
              </div>
            </article>
            <article class="icon-card fade-in">
              <div class="icon-card__icon"><i class="fa-solid fa-wrench"></i></div>
              <div class="icon-card__content">
                <h3>Technical Rework & Repair</h3>
                <p>Precision rework programs with specialized tooling, traceability, and full quality documentation at our facilities.</p>
              </div>
            </article>
            <article class="icon-card fade-in">
              <div class="icon-card__icon"><i class="fa-solid fa-comments"></i></div>
              <div class="icon-card__content">
                <h3>OEM Direct Communication</h3>
                <p>Real-time escalation channels and multilingual support bridging geographic and cultural gaps.</p>
              </div>
            </article>
            <article class="icon-card fade-in">
              <div class="icon-card__icon"><i class="fa-solid fa-arrows-rotate"></i></div>
              <div class="icon-card__content">
                <h3>Supply Chain Coordination</h3>
                <p>End-to-end program management from deviation detection to root cause resolution and parts release.</p>
              </div>
            </article>
          </div>
          <div class="split-section__visual fade-in">
            <img src="https://images.unsplash.com/photo-1556761175-5973dc0f32e7?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80" alt="AAIG global team collaboration and quality engineering" loading="lazy" width="600" height="400">
            <div class="visual-overlay-stat">
              <span class="visual-overlay-stat__number">3</span>
              <span class="visual-overlay-stat__label">Continents<br>Covered</span>
            </div>
          </div>
        </div>

        <div class="section-cta fade-in">
          <a href="global.html" class="btn btn--outline">View Global Presence</a>
        </div>
      </div>
    </section>

    <!-- ==================== QUALITY ENGINEERING & INSPECTION ==================== -->
    <section id="quality" class="section section--ink">
      <div class="container">
        <div class="section-intro section-intro--light fade-in">
          <span class="section-tag section-tag--light"><i class="fa-solid fa-microscope"></i> Quality Engineering & Inspection</span>
          <h2 class="section-title">Containment. Inspection. Confidence.</h2>
          <p class="section-subtitle">From rapid containment to final release — we protect production schedules with certified quality processes, on-site teams, and rigorous inspection protocols.</p>
        </div>

        <div class="quality-grid stagger-children">
          <article class="quality-card fade-in">
            <div class="quality-card__number">01</div>
            <div class="quality-card__icon"><i class="fa-solid fa-shield-halved"></i></div>
            <h3>Containment & Quality Firewalls</h3>
            <p>Immediate isolation of suspect parts with 100% sorting and quality gates to prevent further escapes.</p>
          </article>
          <article class="quality-card fade-in">
            <div class="quality-card__number">02</div>
            <div class="quality-card__icon"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
            <h3>Pre-Delivery Inspection & Testing</h3>
            <p>Dimensional checks, functional testing, and visual inspection against customer specifications before ship-out.</p>
          </article>
          <article class="quality-card fade-in">
            <div class="quality-card__number">03</div>
            <div class="quality-card__icon"><i class="fa-solid fa-rocket"></i></div>
            <h3>Launch Support & Root Cause Analysis</h3>
            <p>Embedded engineers for new program launches, PPAP support, 8D reporting, and corrective action tracking.</p>
          </article>
          <article class="quality-card fade-in">
            <div class="quality-card__number">04</div>
            <div class="quality-card__icon"><i class="fa-solid fa-clipboard-check"></i></div>
            <h3>Supplier Quality Development</h3>
            <p>Process audits, FMEA reviews, and capability assessments to strengthen your supplier base quality performance.</p>
          </article>
        </div>

        <div class="quality-promise fade-in">
          <i class="fa-solid fa-bolt"></i>
          <div>
            <strong>Our Response Promise:</strong> We respond within 1 business day. Emergency containment teams deploy within 48 hours — anywhere in our network.
          </div>
        </div>

        <div class="section-cta fade-in">
          <a href="services.html" class="btn btn--primary">Explore All Services</a>
        </div>
      </div>
    </section>

    <!-- ==================== CLIENT LOGOS & LOCATIONS ==================== -->
    <section id="clients" class="section">
      <div class="container">
        <div class="section-intro fade-in">
          <span class="section-tag"><i class="fa-solid fa-handshake"></i> Trusted Partners</span>
          <h2 class="section-title">Trusted by Leading OEMs & Tier-1 Suppliers</h2>
          <p class="section-subtitle">We operate under NDA with global automotive leaders. Our client base includes OEMs, Tier-1 suppliers, and engineering companies across three continents.</p>
        </div>

        <!-- Logo Strip -->
        <div class="logo-strip fade-in">
          <div class="logo-strip__item">
            <div class="logo-placeholder"><i class="fa-solid fa-industry"></i><span>Global OEM</span></div>
          </div>
          <div class="logo-strip__item">
