        "addressCountry": "IN"
      },
      {
        "@type": "PostalAddress",
        "addressLocality": "Wixom",
        "addressRegion": "MI",
        "addressCountry": "US"
      }
    ],
    "areaServed": ["India", "United States", "Germany", "United Kingdom", "Mexico"],
    "hasCredential": [
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "ISO 9001:2015" },
      { "@type": "EducationalOccupationalCredential", "credentialCategory": "MMSDC Certified" }
    ],
    "sameAs": [
      "https://www.linkedin.com/company/aa-infinite-global-services"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "LocalBusiness",
    "name": "AAIG Wixom Warehouse",
    "image": "",
